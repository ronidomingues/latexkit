{
  "id": "book",
  "name": "Livro (memoir)",
  "description": "Livro para impressao ou leitura digital: folha de rosto, creditos, prefacio, partes e capitulos, epigrafes, indice remissivo e posfacio.",
  "documentClass": "memoir",
  "engine": "pdflatex",
  "entry": "main.tex",
  "vars": [
    {
      "key": "title",
      "prompt": "Titulo do livro",
      "required": true
    },
    {
      "key": "subtitle",
      "prompt": "Subtitulo",
      "default": ""
    },
    {
      "key": "author",
      "prompt": "Autor",
      "required": true
    },
    {
      "key": "publisher",
      "prompt": "Editora",
      "default": ""
    },
    {
      "key": "isbn",
      "prompt": "ISBN",
      "default": ""
    },
    {
      "key": "city",
      "prompt": "Cidade",
      "default": ""
    },
    {
      "key": "year",
      "prompt": "Ano",
      "auto": "year"
    }
  ],
  "features": {
    "bibliography": true,
    "markdown": true,
    "abstract": false,
    "figures": true,
    "index": true
  },
  "checks": [
    "metadata",
    "figure-caption",
    "figure-source",
    "orphan-citations",
    "uncited-entries",
    "unused-figures"
  ]
}
