{
  "name": "latexgen",
  "version": "0.1.0",
  "description": "Gerador de projetos LaTeX academicos e profissionais seguindo a ABNT: artigo, TCC/dissertacao/tese, relatorio tecnico, livro, slides e oficio, com compilacao para PDF em um comando.",
  "keywords": [
    "latex",
    "abnt",
    "abntex2",
    "beamer",
    "memoir",
    "tcc",
    "dissertacao",
    "tese",
    "artigo-cientifico",
    "monografia",
    "relatorio",
    "scaffold",
    "boilerplate",
    "generator",
    "pdf",
    "bibtex",
    "biblatex",
    "portugues",
    "brasil"
  ],
  "homepage": "https://github.com/ronidomingues/latexgen#readme",
  "bugs": {
    "url": "https://github.com/ronidomingues/latexgen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronidomingues/latexgen.git"
  },
  "license": "MIT",
  "author": "Ronivaldo D. Andrade",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "latexgen": "./bin/latexgen.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
