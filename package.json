{
  "name": "latexgen",
  "version": "0.1.0",
  "description": "Gerador de projetos LaTeX academicos (ABNT): artigos, TCC, slides, livros e relatorios, com compilacao para PDF em um comando.",
  "keywords": [
    "latex",
    "abnt",
    "abntex2",
    "beamer",
    "tcc",
    "artigo",
    "scaffold",
    "pdf"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "latexgen": "./bin/latexgen.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronivaldo/latexgen.git"
  }
}
